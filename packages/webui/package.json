{
  "name": "@mavis/webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebUI client for the harness layer. Foundation only; first end-to-end behaviour ships in later slices.",
  "engines": {
    "node": ">=22.19 <23 || >=24.2 <27"
  },
  "scripts": {
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --config ../../vitest.oss.config.mjs"
  },
  "dependencies": {
    "@mavis/protocol": "workspace:*",
    "@mavis/shared": "workspace:^",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
