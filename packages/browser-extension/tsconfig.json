{
  "compilerOptions": {
    "target": "ES2024",
    // The DOM libraries are the point: this package is type-checked against the
    // browser it runs in, so an accidental reach for a Node global is an error
    // here rather than a failure inside a service worker.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}